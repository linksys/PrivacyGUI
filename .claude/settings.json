{
  "permissions": {
    "allow": [
      "Bash(find lib/ test/ -name \"*.dart\" -exec grep -l \"uspServiceProvider\" {} \\\\;)",
      "Bash(find lib/ test/ -name \"*.dart\" -exec grep -l \"usp_service_provider.dart\" {} \\\\;)",
      "Bash(find lib/ test/ -name \"*.dart\" -exec grep -l \"UspService[^A-Za-z]\" {} \\\\;)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/pr_gate.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
