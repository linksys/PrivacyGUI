      "_style_options": ["glass", "flat", "brutal", "neumorphic", "pixel", "aurora"],
      "seedColor": "#6750A4",
      "visualEffects": 0,
      "globalOverlay": "none",
      "_globalOverlay_options": ["none", "noiseOverlay", "crtShader", "auroraGlow", "snow", "hacker"],
      "colors": {
