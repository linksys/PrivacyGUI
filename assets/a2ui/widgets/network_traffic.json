{
  "widgetId": "a2ui_network_traffic",
  "displayName": "Network Traffic",
  "description": "Shows current network upload and download speeds with traffic monitoring",
  "icon": "swap_vert",
  "iconColor": "#66BB6A",
  "navigateTo": "/apps/network-traffic/",
  "constraints": {
    "minColumns": 3,
    "maxColumns": 5,
    "preferredColumns": 4,
    "minRows": 2,
    "maxRows": 3,
    "preferredRows": 2
  },
  "template": {
    "type": "Row",
    "props": {
      "mainAxisAlignment": "spaceBetween",
      "children": [
        {
          "type": "Column",
          "props": {
            "crossAxisAlignment": "start",
            "mainAxisSize": "min",
            "children": [
              {
                "type": "Row",
                "props": {
                  "mainAxisSize": "min",
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "AppIcon",
                      "props": {"icon": "upload", "size": 16, "color": "success"}
                    },
                    {
                      "type": "AppGap",
                      "props": {"size": "xs"}
                    },
                    {
                      "type": "AppText",
                      "props": {
                        "text": {"$bind": "router.uploadSpeed"},
                        "variant": "bodyMedium",
                        "color": "success"
                      }
                    }
                  ]
                }
              },
              {
                "type": "AppGap",
                "props": {"size": "xs"}
              },
              {
                "type": "Row",
                "props": {
                  "mainAxisSize": "min",
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "AppIcon",
                      "props": {"icon": "download", "size": 16, "color": "info"}
                    },
                    {
                      "type": "AppGap",
                      "props": {"size": "xs"}
                    },
                    {
                      "type": "AppText",
                      "props": {
                        "text": {"$bind": "router.downloadSpeed"},
                        "variant": "bodyMedium",
                        "color": "info"
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "type": "Column",
          "props": {
            "crossAxisAlignment": "end",
            "mainAxisSize": "min",
            "children": [
              {
                "type": "AppText",
                "props": {
                  "text": {"$bind": "router.deviceCount"},
                  "variant": "bodySmall",
                  "color": "onSurfaceVariant"
                }
              },
              {
                "type": "AppText",
                "props": {
                  "text": "Active",
                  "variant": "bodySmall",
                  "color": "onSurfaceVariant"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
