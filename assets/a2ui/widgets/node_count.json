{
  "widgetId": "a2ui_node_count",
  "displayName": "Mesh Nodes",
  "description": "Shows mesh node count with navigation to mesh network settings",
  "icon": "router",
  "navigateTo": "/apps/mesh-topology/",
  "headerBadge": {"$bind": "router.nodeCount"},
  "constraints": {
    "minColumns": 2,
    "maxColumns": 4,
    "preferredColumns": 3,
    "minRows": 2,
    "maxRows": 3,
    "preferredRows": 2
  },
  "template": {
    "type": "Column",
    "props": {
      "mainAxisAlignment": "center",
      "crossAxisAlignment": "center",
      "children": [
        {
          "type": "AppText",
          "props": {
            "text": {"$bind": "router.nodeCount"},
            "variant": "headlineMedium",
            "color": "primary"
          }
        },
        {
          "type": "AppText",
          "props": {
            "text": "Mesh Nodes",
            "variant": "bodyMedium",
            "color": "onSurfaceVariant",
            "textAlign": "center"
          }
        }
      ]
    }
  }
}
