{
  "widgetId": "a2ui_system_health",
  "displayName": "System Health",
  "description": "Shows router system health status with diagnostic actions",
  "icon": "monitor_heart",
  "navigateTo": "/apps/system-health/",
  "headerBadge": "Excellent",
  "constraints": {
    "minColumns": 3,
    "maxColumns": 6,
    "preferredColumns": 4,
    "minRows": 2,
    "maxRows": 3,
    "preferredRows": 3
  },
  "template": {
    "type": "Column",
    "props": {
      "mainAxisAlignment": "spaceBetween",
      "crossAxisAlignment": "stretch",
      "children": [
        {
          "type": "Row",
          "props": {
            "mainAxisAlignment": "spaceBetween",
            "children": [
              {
                "type": "Column",
                "props": {
                  "crossAxisAlignment": "start",
                  "mainAxisSize": "min",
                  "children": [
                    {
                      "type": "Row",
                      "props": {
                        "mainAxisSize": "min",
                        "crossAxisAlignment": "center",
                        "children": [
                          {
                            "type": "AppIcon",
                            "props": {"icon": "memory", "size": 16, "color": "success"}
                          },
                          {
                            "type": "AppGap",
                            "props": {"size": "xs"}
                          },
                          {
                            "type": "AppText",
                            "props": {
                              "text": {"$bind": "system.cpuUsage"},
                              "variant": "bodySmall"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "type": "AppGap",
                      "props": {"size": "xs"}
                    },
                    {
                      "type": "Row",
                      "props": {
                        "mainAxisSize": "min",
                        "crossAxisAlignment": "center",
                        "children": [
                          {
                            "type": "AppIcon",
                            "props": {"icon": "storage", "size": 16, "color": "warning"}
                          },
                          {
                            "type": "AppGap",
                            "props": {"size": "xs"}
                          },
                          {
                            "type": "AppText",
                            "props": {
                              "text": {"$bind": "system.memoryUsage"},
                              "variant": "bodySmall"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "type": "Column",
                "props": {
                  "crossAxisAlignment": "end",
                  "mainAxisSize": "min",
                  "children": [
                    {
                      "type": "Row",
                      "props": {
                        "mainAxisSize": "min",
                        "crossAxisAlignment": "center",
                        "children": [
                          {
                            "type": "AppIcon",
                            "props": {"icon": "device_thermostat", "size": 16, "color": "success"}
                          },
                          {
                            "type": "AppGap",
                            "props": {"size": "xs"}
                          },
                          {
                            "type": "AppText",
                            "props": {
                              "text": {"$bind": "system.temperature"},
                              "variant": "bodySmall"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "type": "AppGap",
                      "props": {"size": "xs"}
                    },
                    {
                      "type": "AppText",
                      "props": {
                        "text": {"$bind": "system.uptime"},
                        "variant": "bodySmall",
                        "color": "onSurfaceVariant"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  }
}
