{
  "widgetId": "demo_wifi_status_simple",
  "displayName": "WiFi Status",
  "description": "WiFi network status display with connection information (Demo version with static data)",
  "constraints": {
    "minColumns": 3,
    "maxColumns": 5,
    "preferredColumns": 4,
    "minRows": 3,
    "maxRows": 4,
    "preferredRows": 3
  },
  "_comments": {
    "realWorldUsage": "In production, this would use USP subscription:",
    "subscription": {
      "paths": [
        "Device.WiFi.SSID.1.SSID",
        "Device.WiFi.SSID.1.Status",
        "Device.WiFi.AccessPoint.1.AssociatedDeviceNumberOfEntries"
      ],
      "interval": 5000
    }
  },
  "template": {
    "type": "Column",
    "props": {
      "crossAxisAlignment": "stretch",
      "children": [
        {
          "type": "Row",
          "props": {
            "mainAxisAlignment": "spaceBetween",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "AppText",
                "props": {
                  "text": "Linksys_5G",
                  "variant": "titleMedium"
                }
              },
              {
                "type": "AppIcon",
                "props": {
                  "name": "wifi",
                  "color": "success",
                  "size": 24
                }
              }
            ]
          }
        },
        {
          "type": "AppGap",
          "props": {"size": "md"}
        },
        {
          "type": "AppCard",
          "props": {
            "padding": 12,
            "backgroundColor": "successContainer",
            "children": [
              {
                "type": "Column",
                "props": {
                  "crossAxisAlignment": "start",
                  "children": [
                    {
                      "type": "AppText",
                      "props": {
                        "text": "Network Online",
                        "variant": "bodyMedium"
                      }
                    },
                    {
                      "type": "AppGap",
                      "props": {"size": "xs"}
                    },
                    {
                      "type": "Row",
                      "props": {
                        "mainAxisAlignment": "spaceBetween",
                        "children": [
                          {
                            "type": "AppText",
                            "props": {
                              "text": "12 devices",
                              "variant": "bodySmall"
                            }
                          },
                          {
                            "type": "AppText",
                            "props": {
                              "text": "5 GHz",
                              "variant": "bodySmall"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "type": "AppGap",
          "props": {"size": "lg"}
        },
        {
          "type": "Row",
          "props": {
            "mainAxisAlignment": "spaceEvenly",
            "children": [
              {
                "type": "AppButton",
                "props": {
                  "label": "Settings",
                  "variant": "tonal",
                  "size": "small",
                  "icon": "settings",
                  "onTap": {
                    "$action": "navigate_to_wifi_settings"
                  }
                }
              },
              {
                "type": "AppButton",
                "props": {
                  "label": "Devices",
                  "variant": "base",
                  "size": "small",
                  "onTap": {
                    "$action": "show_connected_devices"
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}