{
  "widgetId": "a2ui_quick_actions",
  "displayName": "Quick Actions",
  "description": "Quick access to common router actions and settings",
  "icon": "bolt",
  "constraints": {
    "minColumns": 3,
    "maxColumns": 6,
    "preferredColumns": 4,
    "minRows": 2,
    "maxRows": 4,
    "preferredRows": 3
  },
  "template": {
    "type": "Column",
    "props": {
      "mainAxisAlignment": "spaceEvenly",
      "crossAxisAlignment": "stretch",
      "children": [
        {
          "type": "Row",
          "props": {
            "mainAxisAlignment": "spaceEvenly",
            "children": [
              {
                "type": "Column",
                "props": {
                  "mainAxisSize": "min",
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "AppIconButton",
                      "props": {
                        "icon": "wifi",
                        "variant": "highlight",
                        "onTap": {
                          "$action": "navigate",
                          "destination": "menuIncredibleWiFi"
                        }
                      }
                    },
                    {
                      "type": "AppGap",
                      "props": {"size": "xs"}
                    },
                    {
                      "type": "AppText",
                      "props": {
                        "text": "WiFi",
                        "variant": "bodySmall",
                        "textAlign": "center"
                      }
                    }
                  ]
                }
              },
              {
                "type": "Column",
                "props": {
                  "mainAxisSize": "min",
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "AppIconButton",
                      "props": {
                        "icon": "security",
                        "variant": "base",
                        "onTap": {
                          "$action": "navigate",
                          "destination": "menuInstantSafety"
                        }
                      }
                    },
                    {
                      "type": "AppGap",
                      "props": {"size": "xs"}
                    },
                    {
                      "type": "AppText",
                      "props": {
                        "text": "Security",
                        "variant": "bodySmall",
                        "textAlign": "center"
                      }
                    }
                  ]
                }
              },
              {
                "type": "Column",
                "props": {
                  "mainAxisSize": "min",
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "AppIconButton",
                      "props": {
                        "icon": "refresh",
                        "variant": "base",
                        "onTap": {
                          "$action": "refresh_data"
                        }
                      }
                    },
                    {
                      "type": "AppGap",
                      "props": {"size": "xs"}
                    },
                    {
                      "type": "AppText",
                      "props": {
                        "text": "Refresh",
                        "variant": "bodySmall",
                        "textAlign": "center"
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "type": "AppGap",
          "props": {"size": "sm"}
        },
        {
          "type": "AppButton",
          "props": {
            "label": "Restart Router",
            "variant": "base",
            "size": "small",
            "icon": "restart_alt"
          }
        }
      ]
    }
  }
}
