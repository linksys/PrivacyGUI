{
  "widgetId": "a2ui_device_count",
  "displayName": "Connected Devices",
  "description": "Shows the number of connected devices with navigation to device list",
  "icon": "devices",
  "iconColor": "#7E57C2",
  "navigateTo": "/apps/device-manager/",
  "headerBadge": {"$bind": "router.deviceCount"},
  "constraints": {
    "minColumns": 2,
    "maxColumns": 4,
    "preferredColumns": 3,
    "minRows": 2,
    "maxRows": 3,
    "preferredRows": 2
  },
  "template": {
    "type": "Column",
    "props": {
      "mainAxisAlignment": "center",
      "crossAxisAlignment": "center",
      "children": [
        {
          "type": "AppText",
          "props": {
            "text": {"$bind": "router.deviceCount"},
            "variant": "headlineMedium",
            "color": "primary"
          }
        },
        {
          "type": "AppText",
          "props": {
            "text": "Connected Devices",
            "variant": "bodyMedium",
            "textAlign": "center"
          }
        }
      ]
    }
  }
}
