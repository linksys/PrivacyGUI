{
  "widgetId": "demo_security_center",
  "displayName": "Security Center",
  "description": "Comprehensive security monitoring and threat protection dashboard",
  "constraints": {
    "minColumns": 3,
    "maxColumns": 6,
    "preferredColumns": 5,
    "preferredRows": 4,
    "minRows": 3,
    "maxRows": 7
  },
  "template": {
    "type": "Column",
    "props": {
      "mainAxisAlignment": "start",
      "crossAxisAlignment": "stretch",
      "children": [
        {
          "type": "Row",
          "props": {
            "mainAxisAlignment": "spaceBetween",
            "children": [
              {
                "type": "AppText",
                "props": {
                  "text": "Security Center",
                  "variant": "titleMedium"
                }
              },
              {
                "type": "AppIcon",
                "props": {
                  "name": "shield",
                  "color": "success",
                  "size": 24
                }
              }
            ]
          }
        },
        {
          "type": "AppGap",
          "props": {
            "size": "md"
          }
        },
        {
          "type": "AppCard",
          "props": {
            "padding": 12,
            "backgroundColor": "successContainer",
            "children": [
              {
                "type": "Row",
                "props": {
                  "children": [
                    {
                      "type": "AppIcon",
                      "props": {
                        "name": "check_circle",
                        "color": "success",
                        "size": 20
                      }
                    },
                    {
                      "type": "AppGap",
                      "props": {
                        "size": "sm"
                      }
                    },
                    {
                      "type": "Column",
                      "props": {
                        "crossAxisAlignment": "start",
                        "children": [
                          {
                            "type": "AppText",
                            "props": {
                              "text": "Network Protected",
                              "variant": "bodyMedium"
                            }
                          },
                          {
                            "type": "AppText",
                            "props": {
                              "text": "All security features active",
                              "variant": "bodySmall",
                              "color": "onSurfaceVariant"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "type": "AppGap",
          "props": {
            "size": "md"
          }
        },
        {
          "type": "Row",
          "props": {
            "mainAxisAlignment": "spaceBetween",
            "children": [
              {
                "type": "Column",
                "props": {
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "AppText",
                      "props": {
                        "text": "15",
                        "variant": "headlineMedium",
                        "color": "error"
                      }
                    },
                    {
                      "type": "AppText",
                      "props": {
                        "text": "Blocked",
                        "variant": "bodySmall"
                      }
                    }
                  ]
                }
              },
              {
                "type": "Column",
                "props": {
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "AppText",
                      "props": {
                        "text": "0",
                        "variant": "headlineMedium",
                        "color": "success"
                      }
                    },
                    {
                      "type": "AppText",
                      "props": {
                        "text": "Threats",
                        "variant": "bodySmall"
                      }
                    }
                  ]
                }
              },
              {
                "type": "Column",
                "props": {
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "AppText",
                      "props": {
                        "text": "99.8%",
                        "variant": "headlineMedium",
                        "color": "primary"
                      }
                    },
                    {
                      "type": "AppText",
                      "props": {
                        "text": "Uptime",
                        "variant": "bodySmall"
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "type": "AppGap",
          "props": {
            "size": "lg"
          }
        },
        {
          "type": "Row",
          "props": {
            "mainAxisAlignment": "spaceEvenly",
            "children": [
              {
                "type": "AppButton",
                "props": {
                  "label": "Scan Network",
                  "variant": "highlight",
                  "size": "small",
                  "onTap": {
                    "$action": "security_scan"
                  }
                }
              },
              {
                "type": "AppButton",
                "props": {
                  "label": "View Logs",
                  "onTap": {
                    "$action": "navigate",
                    "destination": "security_logs"
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}