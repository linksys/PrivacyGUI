{
  "widgetId": "a2ui_wan_status",
  "displayName": "WAN Status",
  "description": "Shows WAN connection status with navigation to network settings",
  "icon": "language",
  "iconColor": "#4FC3F7",
  "navigateTo": "/apps/wan-status/",
  "headerBadge": {"$bind": "router.wanStatus"},
  "constraints": {
    "minColumns": 2,
    "maxColumns": 5,
    "preferredColumns": 4,
    "minRows": 1,
    "maxRows": 2,
    "preferredRows": 2
  },
  "template": {
    "type": "Row",
    "props": {
      "mainAxisAlignment": "center",
      "crossAxisAlignment": "center",
      "mainAxisSize": "min",
      "children": [
        {
          "type": "AppIcon",
          "props": {
            "icon": {"$bind": "router.wanStatus === 'Online' ? 'wifi' : 'wifi_off'"},
            "size": 24,
            "color": {"$bind": "router.wanStatus === 'Online' ? 'success' : 'error'"}
          }
        },
        {
          "type": "AppGap",
          "props": {"size": "sm"}
        },
        {
          "type": "AppText",
          "props": {
            "text": {"$bind": "router.wanStatus"},
            "variant": "bodyMedium",
            "color": {"$bind": "router.wanStatus === 'Online' ? 'success' : 'error'"}
          }
        }
      ]
    }
  }
}
