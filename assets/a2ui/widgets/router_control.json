{
  "widgetId": "a2ui_router_control",
  "displayName": "Router Control Panel",
  "description": "Interactive router control with restart and reset capabilities",
  "icon": "router",
  "headerBadge": {"$bind": "router.wanStatus"},
  "headerExtra": {"$bind": "router.uptime"},
  "constraints": {
    "minColumns": 3,
    "maxColumns": 6,
    "preferredColumns": 4,
    "minRows": 3,
    "maxRows": 5,
    "preferredRows": 4
  },
  "template": {
    "type": "Column",
    "props": {
      "mainAxisAlignment": "spaceEvenly",
      "crossAxisAlignment": "stretch",
      "children": [
        {
          "type": "Column",
          "props": {
            "mainAxisSize": "min",
            "children": [
              {
                "type": "AppButton",
                "props": {
                  "label": "Power Control",
                  "variant": "highlight",
                  "icon": "power"
                }
              },
              {
                "type": "AppGap",
                "props": {"size": "sm"}
              },
              {
                "type": "AppButton",
                "props": {
                  "label": "Restart Router",
                  "variant": "base",
                  "icon": "restart_alt"
                }
              },
              {
                "type": "AppGap",
                "props": {"size": "sm"}
              },
              {
                "type": "AppButton",
                "props": {
                  "label": "Factory Reset",
                  "variant": "base",
                  "icon": "settings_backup_restore"
                }
              }
            ]
          }
        },
        {
          "type": "AppGap",
          "props": {"size": "md"}
        },
        {
          "type": "Row",
          "props": {
            "mainAxisAlignment": "spaceAround",
            "children": [
              {
                "type": "Column",
                "props": {
                  "mainAxisSize": "min",
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "AppText",
                      "props": {
                        "text": {"$bind": "router.deviceCount"},
                        "variant": "titleLarge"
                      }
                    },
                    {
                      "type": "AppText",
                      "props": {
                        "text": "Devices",
                        "variant": "bodySmall"
                      }
                    }
                  ]
                }
              },
              {
                "type": "Column",
                "props": {
                  "mainAxisSize": "min",
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "AppText",
                      "props": {
                        "text": {"$bind": "router.nodeCount"},
                        "variant": "titleLarge"
                      }
                    },
                    {
                      "type": "AppText",
                      "props": {
                        "text": "Nodes",
                        "variant": "bodySmall"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  }
}
